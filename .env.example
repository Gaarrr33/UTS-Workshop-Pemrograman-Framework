# ==============================================================
# KONFIGURASI APLIKASI ENKRIPSI-DEKRIPSI ANTAR DATABASE (UTS)
# MENGGUNAKAN XAMPP MYSQL / MARIADB
# ==============================================================

# Port Layanan
PORT_SERVER_A=4001
PORT_SERVER_B=4002
PORT_GATEWAY=3000

# URL Komunikasi Antar Layanan
SERVER_A_URL=http://localhost:4001
SERVER_B_URL=http://localhost:4002
GATEWAY_URL=http://localhost:3000

# Konfigurasi Koneksi MySQL/MariaDB (XAMPP)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_A_NAME=db_a
DB_B_NAME=db_b

# Lokasi Kunci Kriptografi RSA-OAEP
RSA_KEY_SIZE=2048
PUBLIC_KEY_PATH=./keys/server_b_public.pem
PRIVATE_KEY_PATH=./keys/server_b_private.pem

# Environment
NODE_ENV=development
