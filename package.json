{
  "name": "uts-enkripsi-dekripsi-database",
  "version": "1.0.0",
  "description": "Implementasi Enkripsi dan Dekripsi Data Antar Database Menggunakan AES-256-GCM dan RSA-OAEP",
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "server:utama": "node server_utama.js",
    "server:cadangan": "node server_cadangan.js",
    "frontend": "npm --prefix frontend run dev",
    "server:a": "node src/serverA/index.js",
    "server:b": "node src/serverB/index.js",
    "db:init": "node src/scripts/initDb.js",
    "keys:generate": "node src/scripts/generateKeys.js",
    "pdf:generate": "node src/scripts/generatePdf.js",
    "test": "node --test tests/e2e_crypto.test.js"
  },
  "keywords": [
    "encryption",
    "decryption",
    "aes-256-gcm",
    "rsa-oaep",
    "sqlite",
    "express"
  ],
