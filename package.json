  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.24.5",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
